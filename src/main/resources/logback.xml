<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-${user.home}/AppData/Local/PashaApps/AppFleet/logs}"/>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/appfleet.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_DIR}/appfleet.%i.log</fileNamePattern>
            <minIndex>1</minIndex><maxIndex>9</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>5MB</maxFileSize>
        </triggeringPolicy>
        <encoder><charset>UTF-8</charset><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger - %msg%n</pattern></encoder>
    </appender>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><charset>UTF-8</charset><pattern>%d{HH:mm:ss} %-5level %logger - %msg%n</pattern></encoder>
    </appender>
    <root level="INFO"><appender-ref ref="FILE"/><appender-ref ref="CONSOLE"/></root>
</configuration>

